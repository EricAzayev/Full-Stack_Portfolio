{
  "name": "foodtracker",
  "private": true,
  "version": "1.0.0",
  "description": "Local food tracking application",
  "author": "Your Name",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "dev:electron": "electron .",
    "build:renderer": "vite build",
    "rebuild:native:node": "npm rebuild better-sqlite3 --prefix server",
    "rebuild:native": "npx electron-rebuild -f -w better-sqlite3 -m ./server",
    "package:app": "electron-builder --config electron-builder.prod.json",
    "package:test-app": "electron-builder --config electron-builder.test.json",
    "build": "npm run build:renderer && npm run rebuild:native && npm run package:app && npm run package:test-app",
    "build:app": "npm run build",
    "preview": "vite preview"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "react": "^18.2.0",
    "react-circular-progressbar": "^2.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.2.1",
    "electron": "^39.2.7",
    "electron-builder": "^26.0.12",
    "vite": "^5.0.8"
  },
  "build": {}
}
