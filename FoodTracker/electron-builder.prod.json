{
  "appId": "com.foodtracker.app",
  "productName": "FoodTracker",
  "artifactName": "FoodTracker Setup ${version}.${ext}",
  "icon": "DataFork Logo.png",
  "directories": {
    "output": "release/prod"
  },
  "files": [
    "dist/**/*",
    "electron/**/*",
    "node_modules/**/*",
    "package.json"
  ],
  "extraResources": [
    "server"
  ],
  "npmRebuild": false,
  "nodeGypRebuild": false,
  "buildDependenciesFromSource": false,
  "win": {
    "icon": "DataFork Logo.png",
    "executableName": "FoodTracker",
    "target": [
      "nsis"
    ]
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true
  }
}