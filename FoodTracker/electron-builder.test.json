{
  "appId": "com.foodtracker.app.test",
  "productName": "TestFoodTracker",
  "artifactName": "TestFoodTracker Setup ${version}.${ext}",
  "icon": "DataFork TestingLogo.png",
  "directories": {
    "output": "release/test"
  },
  "files": [
    "dist/**/*",
    "electron/**/*",
    "node_modules/**/*",
    "package.json"
  ],
  "extraResources": [
    "server"
  ],
  "npmRebuild": false,
  "nodeGypRebuild": false,
  "buildDependenciesFromSource": false,
  "win": {
    "icon": "DataFork TestingLogo.png",
    "executableName": "TestFoodTracker",
    "target": [
      "nsis"
    ]
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "installerSidebar": "installerSidebar.bmp",
    "uninstallerSidebar": "uninstallerSidebar.bmp",
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true
  }
}